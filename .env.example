# Copie este arquivo para .env e configure os valores.
PORT=3333
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
# Gerado automaticamente pelo comando npm run setup:admin
ADMIN_PASSWORD_HASH=
# Número oficial do estúdio no formato internacional, somente números.
# Exemplo de formato: 55DDDNUMERO. Deixe vazio até definir o número comercial.
WHATSAPP_NUMBER=
